{
  "permissions": {
    "deny": [
      "Read(./_restrito/**)",
      "Edit(./_restrito/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Grep|Glob|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-restrito.js\"",
            "statusMessage": "Verificando regra clean-room..."
          }
        ]
      }
    ]
  }
}
